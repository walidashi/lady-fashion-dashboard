NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
INVENTORY_API_KEY=your-inventory-api-key-here

# ── Shopify (server-only; never prefix with NEXT_PUBLIC_) ───────────────────
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# Either a static Admin API token (legacy admin-created custom app)...
SHOPIFY_ADMIN_TOKEN=
# ...or a Dev Dashboard app's client credentials (token refreshed automatically)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_WEBHOOK_SECRET=

# ── Meta Conversions API ────────────────────────────────────────────────────
META_DATASET_ID=1420587236584709
META_CAPI_TOKEN=
# Set only while testing in Events Manager > Test Events, then remove
META_TEST_EVENT_CODE=

# One-off backfill tool for past orders; leave false except while using it
SYNC_BACKFILL_ENABLED=false
